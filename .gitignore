# Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ruby
*.gem
.bundle
vendor/
# Re-include the static-asset vendor tree (third-party JS bundles
# vendored per the minimal-computing principle — see assets/vendor/README.md)
!assets/vendor/

# Node
node_modules/
# package-lock.json is committed so the CI `npm ci` (build.yml / telar-tests.yml)
# has a lockfile to install from; it is regenerated on every real build.

# System
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment
.env

# Build artifacts
*.log
# Stale bundled story output (gitignored to prevent recommit; the active bundle is telar-story.js)
telar-story*.bundle.js
telar-story-bundle.js

# Generated JSON files (from telar-content/spreadsheets/*.csv by csv_to_json.py)
# Source of truth is the CSV files - JSON is regenerated on every build
# Note: With story_id feature, story files use semantic names (e.g., your-story.json, paisajes-demo.json)
_data/objects.json
_data/project.json
_data/*.json
!_data/languages/

# Story page manifest (generate_collections.py records where each story
# renders, so the post-build encryption step never has to guess a URL)
_data/telar-build/

# Migration equivalence harness: recorded GitHub fetches and working
# fixtures. Regenerated by a recording pass — ~11 MB per version, and
# a snapshot of upstream rather than anything this repo authors.
audit/harness/cache/
# Recorded network responses, per baseline. Large (hundreds of MB) and
# rebuilt by capture_baseline.py; a fresh clone recaptures rather than
# carrying them.
audit/harness/baseline/cache/
audit/harness/baseline-090/cache/

# Search data (generated by search.py for browse-and-search feature)
search-data.json

# Generated Jekyll collection files (from telar-content/texts/ by generate_collections.py)
# Source of truth is the markdown files in telar-content/texts/
_jekyll-files/

# Demo glossary JSON (created by csv_to_json.py from demo bundle)
_data/demo-glossary.json

# Demo Content bundle (fetched from content.telar.org, never committed)
_demo_content/

# IIIF Generated Tiles
# TODO: Remove this when testing GitHub Actions workflow
# Tiles should be tracked in production for optimization
iiif/objects/

# Python
__pycache__/
*.py[cod]
*$py.class

# Playwright ephemeral output
playwright-report/
test-results/
tests/playwright/.last-run.json
tests/playwright/screenshots/
# Panel-length sweep output: ~1.2 MB of per-cell JSON regenerated by every run
tests/playwright/measurements/data/
# Centring sweep per-cell output, regenerated by every run. The summaries and
# raw rolls-up beside it are the record; these are the working files behind them.
tests/playwright/centering-measurements/cells/

# Run artefacts of calib-validate, rewritten on every run.
tests/playwright/fixtures/calib-shot.png
tests/playwright/fixtures/calib-expected.json
